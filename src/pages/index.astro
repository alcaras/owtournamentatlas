          </div>
          <div class="rstrip__ics">
            {YIELD_BARS.map((b: any) => {
              const bar = barOf(c, b.key);
              return (
                <a class={`ric${bar.none ? ' ric--none' : ''}`} href={`${baseUrl}rankings?c=${c.slug}#r-${b.key}`} title={barTip(b, bar.d, c)}>
                  <img src={`${baseUrl}img/icons/yields/${b.icon}.png`} alt={b.label} />
                  <div class="ric__bar"><span style={`width:${bar.w}%;background:${bar.col}`}></span></div>
                  <div class="ric__c">{b.label}{!bar.none && rk(c, b.key) && <span class="ric__rk">#{rk(c, b.key)}</span>}</div>
                </a>
              );
            })}
          </div>
          <div class="rstrip__lab rstrip__lab--2">Terrain &amp; topology
            <span class="rstrip__sub">tile counts, never percentages — so they halve per player like everything else · bar = rank among the 18 maps · hover for exact amounts <i>and per-player counts</i></span>
          </div>
          <div class="rstrip__ics">
            {TERRAIN_BARS.map((b: any) => {
              const bar = barOf(c, b.key);
              return (
                <a class={`ric${bar.none ? ' ric--none' : ''}`} href={`${baseUrl}rankings?c=${c.slug}#r-${b.key}`} title={barTip(b, bar.d, c, !!b.pp)}>
                  <svg class="tic" viewBox="0 0 24 24" aria-label={b.label}><use href={`#g-${b.icon}`} /></svg>
                  <div class="ric__bar"><span style={`width:${bar.w}%;background:${bar.col}`}></span></div>
                  <div class="ric__c">{b.label}{!bar.none && rk(c, b.key) && <span class="ric__rk">#{rk(c, b.key)}</span>}</div>
                </a>
              );
            })}
          </div>
        </div>
        <details class="gal" open>
          <summary>{Math.min(c.imgs.length, 21)} generated maps</summary>
          <div class="gal__grid">
            {c.imgs.slice(0, 21).map((p: string) => {
              const id = idFromImg(c.slug, p);
              const gm = genMap[id] || {};
              return (
                <a class="gal__cell" href={`${baseUrl}gen/${id}`} target="_blank" rel="noopener">
                  <img src={`${baseUrl}img/${p}`} loading="lazy" alt={`${c.group} sample`}
                    width={dimBySlug[c.slug].w} height={dimBySlug[c.slug].h} />
                  <div class="cap">
                    <span><i>sites</i><b>{gm.sites ?? '—'}</b></span>
                    <span><i>land</i><b>{gm.land ?? '—'}</b></span>
                    <span><i>cost</i><b>{gm.slLand ?? '—'}</b></span>
                  </div>
                </a>
              );
            })}
          </div>
        </details>
      </div>
        ))}
      </section>
    ))}
  </div>

  <p class="note">
    {pool.length} configs · {N}-ish seeds each. Pool is land-connected
    by construction; split-dropped % is how often a seed had no
    connected symmetric pair.
  </p>

