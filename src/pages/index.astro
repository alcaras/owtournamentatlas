---
import Base from '../layouts/Base.astro';
import dist from '../data/atlas-dist.json';
import gensData from '../data/gens.json';
import gensData from '../data/gens.json';
import { imgDimsBySlug } from '../lib/img-dims';
const baseUrl = import.meta.env.BASE_URL;

// The finalised tournament pool — 16 maps, organised by map script.
// Derived from the Round 1 unanimous locks + the Round 2 vote (8
// voters), trimmed of duplicate-script redundancy (Arid Plateau Small
// Seas and DOTA Jungle each had a 2nd variant cut for being a same-
// script duplicate). This page is the tournament reference.
const POOL: string[] = [
  // Archipelago (sq/sym + wide/nosym for axis+sym variety)
  'archipelago-land-lg-water-sm-smallest-square-sym',
  'archipelago-land-lg-water-sm-smallest-wide-nosym',
  // Arid Plateau (Small Seas + Large Seas)
  'arid-plateau-small-seas-smallest-square-sym',
  'arid-plateau-large-seas-smallest-square-sym',
  // Coastal Rain Basin (wide/nosym locked + sq/sym for sym variety)
  'coastal-rain-basin-smallest-wide-nosym',
  'coastal-rain-basin-smallest-square-sym',
  // Continent
  'continent-smallest-wide-sym',
  // Desert (Lush + No Coast)
  'desert-lush-std-tiny-square-nosym',
  'desert-none-std-tiny-square-sym',
  // Donut
  'donut-irreg-low-smallest-square-sym',
  // DOTA (Jungle, Sand, Water)
  'dota-jungle-smallest-square-sym',
  'dota-sand-smallest-square-sym',
  'dota-water-smallest-square-sym',
  // Hardwood Forest
  'hardwood-forest-smallest-wide-nosym',
  // Inland Sea
  'inland-sea-smallest-square-sym',
  'inland-sea-smallest-wide-nosym',
  // Mountain Pass
  'mountain-pass-smallest-wide-sym',
  // Wetlands
  'wetlands-smallest-square-sym',
];

const genMap: Record<string, any> = {};
for (const gn of (gensData as any).gens)
  genMap[gn.id] = { sites: gn.sites, land: gn.land, conn: gn.conn,
    reach: gn.reachPct, split: gn.split, slLand: gn.slLand };
const idFromImg = (slug: string, p: string) => {
  const m = p.match(/seed-(\d+)/); return `${slug}-s${m ? m[1] : 1}`;
};

const sizeOf = (c: any) =>
  (c.setting || '').split(' · ')[0] === 'Tiny' ? 'Tiny' : 'Duel';
// sidebar / title text: group + variant + size (so the two Continents,
// and any future same-script doubles, are distinguishable)
const navName = (c: any) =>
  `${c.group}${c.variant ? ` · ${c.variant}` : ''} · ${sizeOf(c)}`;
// Compact sidebar label — script name is in the section heading, so
// only show what differs between configs under that heading. For 1-cfg
// sections, fall back to full size · aspect · sym.  Title Case throughout.
const symOf = (c: any) =>
  ((c.setting || '').split(' · ')[2] || '').includes('on') ? 'Sym' : 'No-Sym';
const aspOf = (c: any) => {
  const a = (c.setting || '').split(' · ')[1] || '';
  return a ? a[0].toUpperCase() + a.slice(1) : '';
};
function navLabel(c: any, peers: any[]): string {
  if (peers.length <= 1) return `${sizeOf(c)} · ${aspOf(c)} · ${symOf(c)}`;
  const axes = [
    ['variant', (x: any) => x.variant || ''],
    ['size', sizeOf],
    ['aspect', aspOf],
    ['sym', symOf],
  ] as const;
  const parts: string[] = [];
  for (const [, fn] of axes) {
    const vals = new Set(peers.map(fn));
    if (vals.size > 1) {
      const v = fn(c);
      if (v) parts.push(v);
    }
  }
  return parts.join(' · ') || `${sizeOf(c)} · ${aspOf(c)} · ${symOf(c)}`;
}
const bySlug: Record<string, any> = {};
for (const c of dist.configs) bySlug[c.slug] = c;
const pool = POOL.map((s) => bySlug[s]).filter(Boolean);
const N = pool[0]?.n ?? 0;

// Reserve each gallery <img>'s box before it lazy-loads so #anchor
// deep-links land without layout shift — see src/lib/img-dims.ts.
const dimBySlug = await imgDimsBySlug(pool);

// Group by map script — DOTA by subtype, Desert by coast, else the
// script. Sections are alphabetised; cfgs within a section sorted
// by full name so locked-and-2nd variants sit together.
const dg = (c: any) => {
  if (c.group === 'DOTA') return `DOTA · ${c.variant}`;
  if (c.group === 'Desert') {
    const coast = (c.variant || '').split(' · ')[0];
    return `Desert: ${coast === 'None' ? 'No' : coast} Coast`;
  }
  return c.group;
};
const groupMap: Record<string, any[]> = {};
for (const c of pool) (groupMap[dg(c)] ??= []).push(c);
const sections = Object.keys(groupMap)
  .sort((a, b) => a.toLowerCase().localeCompare(b.toLowerCase()))
  .map((k) => ({
  key: k, title: k,
  cfgs: groupMap[k].sort((a: any, b: any) =>
    navName(a).localeCompare(navName(b))),
}));

// Readable config labels — two plain-English forms per config:
//   full  = "[Aspect] [Size] [Trait] [Map Script] [PS]"   (card title)
//   short = same, script abbreviated + Square→Sq + trait trimmed (sidebar/tag)
// Trait sits adjacent-before the script so it reads as natural English
// ("Lush Desert", "Jungle DOTA", "Large Seas Arid Plateau").
// e.g. full  "Square Tiny No Coast Desert PS"
//      short "Sq Tiny NoCst Desert PS".
// Only options that VARY across the pool are shown (Archipelago/Donut
// have a single variant in the pool, so it's omitted as noise). DOTA is
// point-sym-locked in-game so PS is implied and omitted there; PS is
// shown for every other point-symmetric config. Mirror is always on, so
// it is never shown.
const SCRIPT_FULL: Record<string, string> = {
  'Archipelago': 'Archipelago', 'Arid Plateau': 'Arid Plateau',
  'Coastal Rain Basin': 'Coastal Rain Basin', 'Continent': 'Continent',
  'Desert': 'Desert', 'Donut': 'Donut', 'DOTA': 'DOTA',
  'Hardwood Forest': 'Hardwood Forest', 'Highlands': 'Highlands',
  'Inland Sea': 'Inland Sea', 'Mountain Pass': 'Mountain Pass',
  'Wetlands': 'Wetlands',
};
const SCRIPT_SHORT: Record<string, string> = {
  'Archipelago': 'Arch', 'Arid Plateau': 'AridP',
  'Coastal Rain Basin': 'CRB', 'Continent': 'Cont', 'Desert': 'Desert',
  'Donut': 'Donut', 'DOTA': 'DOTA', 'Hardwood Forest': 'Hardwood',
  'Highlands': 'Highlands', 'Inland Sea': 'InlSea',
  'Mountain Pass': 'MtnPass', 'Wetlands': 'Wetlands',
};
// which script groups have >1 variant in the pool (so the option matters)
const multiVariant = new Set<string>();
{
  const seen: Record<string, Set<string>> = {};
  for (const c of pool) (seen[c.group] ??= new Set()).add(c.variant || '');
  for (const g in seen) if (seen[g].size > 1) multiVariant.add(g);
}
function optionLabel(c: any, short = false): string {
  if (!multiVariant.has(c.group)) return '';
  if (c.group === 'Desert') {
    const coast = (c.variant || '').split(' · ')[0];   // Lush / Dry / None
    if (coast === 'None') return short ? 'NoCst' : 'No Coast';
    return coast;                                       // Lush / Dry
  }
  if (c.group === 'Arid Plateau') {
    if (/large/i.test(c.variant)) return short ? 'Lg Seas' : 'Large Seas';
    if (/small/i.test(c.variant)) return short ? 'Sm Seas' : 'Small Seas';
  }
  return c.variant || '';                              // DOTA: Jungle/Sand/Water/Mountain
}
function cfgLabel(c: any, short = false): string {
  const asp = aspOf(c) === 'Wide' ? 'Wide' : (short ? 'Sq' : 'Square');
  const size = sizeOf(c);                              // Duel / Tiny
  const script = (short ? SCRIPT_SHORT : SCRIPT_FULL)[c.group] || c.group;
  const opt = optionLabel(c, short);
  const ps = (symOf(c) === 'Sym' && c.group !== 'DOTA') ? 'PS' : '';
  return [asp, size, opt, script, ps].filter(Boolean).join(' ');
}
const labelFull: Record<string, string> = {};
const labelShort: Record<string, string> = {};
// URL anchor = the compressed label, slugified — e.g. "Sq Duel Sand DOTA"
// → #cfg-sq-duel-sand-dota (readable hash; the config `slug` stays the
// data key). Compressed labels are unique, so the anchors are too.
const anchorOf: Record<string, string> = {};
const slugify = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
for (const sec of sections)
  for (const c of sec.cfgs) {
    labelFull[c.slug] = cfgLabel(c, false);
    labelShort[c.slug] = cfgLabel(c, true);
    anchorOf[c.slug] = slugify(labelShort[c.slug]);
  }

// ---- Distribution charts ---------------------------------------------
// Per-seed values for the pool, straight from gens.json (the per-map
// source of truth). Powers the pool-wide bar chart at the top and the
// per-config unit dot-histograms above each gallery.
const POOL_SLUGS = new Set(pool.map((c: any) => c.slug));
type MK = 'sites' | 'water' | 'land' | 'slLand' | 'slSea';
type GP = { id: string; slug: string; label: string; seed: number;
  sites: number; water: number; land: number; slLand: number;
  slSea: number };
const poolGens: GP[] = ((gensData as any).gens as any[])
  .filter((gn) => POOL_SLUGS.has(gn.cslug))
  .map((gn) => ({ id: gn.id, slug: gn.cslug, label: gn.label,
    seed: gn.seed, sites: gn.sites, water: gn.water, land: gn.land,
    slLand: gn.slLand, slSea: gn.slSea }));
// Full multi-metric hover line, shared by bars + per-config dots.
const tipOf = (g: GP) =>
  `${g.label} · seed ${g.seed} — ${g.sites} sites · ${g.water} water-hex · `
  + `${g.land} land-hex · ${g.slLand} land-moves · ${g.slSea} water-moves`;

// Chart roster (drives both the pool bars and per-config dots, in
// order). Captions are purely descriptive — what each metric measures,
// not whether a value is "good"; the group hasn't defined that.
const METRICS: { key: MK; name: string; step: number; cap: string }[] = [
  { key: 'sites', name: 'City sites', step: 1,
    cap: 'Number of valid city sites placed on the map.' },
  { key: 'water', name: 'Water-route hexes', step: 5,
    cap: 'Cap→cap shortest path with embark allowed, in hex tiles (no move cost).' },
  { key: 'land', name: 'Land hex distance', step: 5,
    cap: 'Cap→cap shortest land-only path, in hex tiles.' },
  { key: 'slLand', name: 'Land move-cost (moves)', step: 5,
    cap: 'Army (move-2) cap→cap, terrain move-cost weighted, land only — in moves.' },
  { key: 'slSea', name: 'Water move-cost (moves)', step: 5,
    cap: 'Army (move-2) cap→cap, move-cost weighted, embark allowed — in moves.' },
];

type Bin = { x0: number; x1: number; label: string; cells: GP[] };
function bins(items: GP[], key: MK, step: number): Bin[] {
  if (!items.length) return [];
  const vals = items.map((i) => i[key]);
  const lo = Math.min(...vals), hi = Math.max(...vals);
  const start = Math.floor(lo / step) * step;
  const out: Bin[] = [];
  for (let x = start; x <= hi; x += step) {
    const cells = items
      .filter((i) => i[key] >= x && i[key] < x + step)
      .sort((a, b) => a[key] - b[key] || a.seed - b.seed);
    out.push({ x0: x, x1: x + step,
      label: step === 1 ? String(x) : `${x}–${x + step - 1}`, cells });
  }
  return out;
}
// Colour = distance from the mean in std-devs of whatever set is being
// charted (pool for the top bars, the config's own seeds for the
// per-config dots). |z| ≤1 green · ≤2 yellow · ≤3 orange · >3 red.
type Stat = { m: number; s: number };
function stat(vals: number[]): Stat {
  const n = vals.length || 1;
  const m = vals.reduce((a, b) => a + b, 0) / n;
  const s = Math.sqrt(vals.reduce((a, b) => a + (b - m) ** 2, 0) / n);
  return { m, s };
}
const zClass = (v: number, st: Stat) => {
  if (!st.s) return 'z-good';
  const z = Math.abs((v - st.m) / st.s);
  return z <= 1 ? 'z-good' : z <= 2 ? 'z-ok' : z <= 3 ? 'z-edge' : 'z-bad';
};
const maxN = (bs: Bin[]) => Math.max(1, ...bs.map((b) => b.cells.length));
// Pool mean/sd per metric, computed once. The per-config dots colour
// off the SAME pool stats as the top bars so a colour means the same
// thing everywhere (cross-config comparable, not self-normalised).
const poolStat = Object.fromEntries(
  (['sites', 'water', 'land', 'slLand', 'slSea'] as MK[]).map((k) =>
    [k, stat(poolGens.map((g) => g[k]))])) as Record<MK, Stat>;

// ---- In-game SETUP GUIDE ---------------------------------------------
// The exact New Game → Advanced Options to set so the in-game generator
// reproduces this config. Universal four (Size/Aspect/Point-Sym/Mirror)
// are parsed from c.setting; the script + its map-options come from
// owmapgen-lab/scripts/configs.py (single source of truth).
const SCRIPT_NAME: Record<string, string> = {
  'Continent': 'Continent',
  'Coastal Rain Basin': 'Coastal Rain Basin',
  'Donut': 'Donut',
  'Archipelago': 'Archipelago',
  'Arid Plateau': 'Arid Plateau',
  'DOTA': 'Duel of the Ancients',
  'Hardwood Forest': 'Hardwood Forest',
  'Inland Sea': 'Inland Sea',
  'Desert': 'Desert',
  'Mountain Pass': 'Mountain Pass',
  'Highlands': 'Highlands',
};
// keyed by `${group}|${variant}` — script-specific dropdowns to change
const SCRIPT_OPTS: Record<string, [string, string][]> = {
  'Arid Plateau|Small Seas': [['Arid Water Size', 'Small']],
  'Arid Plateau|Large Seas': [['Arid Water Size', 'Large']],
  'Coastal Rain Basin|': [],
  // DOTA (2026-07-01 patch): the single "Separating Terrain" was split
  // into inner (still labelled "Separating Terrain" in-game) + "Outer
  // Terrain", plus a new "Path Width" (default Wide). Pool pins
  // inner==outer to the variant + a Narrow path — see configs._dota.
  'DOTA|Jungle': [['Separating Terrain', 'Jungle'], ['Outer Terrain', 'Jungle'], ['Path Width', 'Narrow']],
  'DOTA|Mountain': [['Separating Terrain', 'Mountains'], ['Outer Terrain', 'Mountains'], ['Path Width', 'Narrow']],
  'DOTA|Water': [['Separating Terrain', 'Water'], ['Outer Terrain', 'Water'], ['Path Width', 'Narrow']],
  'DOTA|Sand': [['Separating Terrain', 'Sand'], ['Outer Terrain', 'Sand'], ['Path Width', 'Narrow']],
  'Inland Sea|': [],
  // In-game the dropdown is labelled "Extreme Terrain" (None/Either/
  // Tundra/Desert), NOT "Continent Terrain" — match what the player sees.
  'Continent|': [['Extreme Terrain', 'None']],
  'Hardwood Forest|': [],
  'Archipelago|Land Lg · Water Sm': [
    ['Archipelago Landmass', 'Large'],
    ['Archipelago Water Size', 'Small']],
  'Desert|Lush · Std': [['Desert Coast', 'Lush'], ['Desert Size', 'Standard']],
  'Desert|None · Std': [['Desert Coast', 'None'], ['Desert Size', 'Standard']],
  'Desert|Dry · Std': [['Desert Coast', 'Dry'], ['Desert Size', 'Standard']],
  'Donut|Irreg Low': [['Donut Irregularity', 'Low']],
  'Mountain Pass|': [],
  'Highlands|': [],
};
type Row = { label: string; value: string; toggle?: boolean };
function setup(c: any): Row[] {
  const p = (c.setting || '').split(' · ');           // Duel · square · point-sym on · mirror
  const aspect = (p[1] || 'square');
  const sym = (p[2] || '').includes('on');
  const rows: Row[] = [
    { label: 'Map Script', value: SCRIPT_NAME[c.group] || c.group },
    { label: 'Map Size', value: p[0] === 'Tiny' ? 'Tiny' : 'Duel' },
    { label: 'Map Aspect Ratio',
      value: aspect.charAt(0).toUpperCase() + aspect.slice(1) },
  ];
  for (const [l, v] of (SCRIPT_OPTS[`${c.group}|${c.variant || ''}`] || []))
    rows.push({ label: l, value: v });
  // DOTA is always point-symmetric in-game — there's no toggle to set, so
  // listing it as a manual ON step is misleading (it's a default, not a
  // step). Other scripts genuinely vary point-sym on/off, so keep the
  // toggle there. The DOTA case is noted under the rows instead.
  if (c.group !== 'DOTA')
    rows.push({ label: 'Point Symmetry', value: sym ? 'ON' : 'OFF', toggle: true });
  rows.push({ label: 'Mirror Map', value: 'ON', toggle: true });
  return rows;
}

// ---- Resource strip --------------------------------------------------
// Per-config resource picture: an icon + a colour bar (green = lots,
// red = low) instead of a wall of numbers. Bar fill/colour is RELATIVE
// to the rest of the pool, so a glance answers "lots of iron here vs
// there". Exact mean ±sd is in the hover tooltip. (Design note from the
// organisers: fewer numbers — most eyes glaze over a stat wall.)
const RES_BARS = [
  { key: 'grain', icon: 'wheat', label: 'Grain',
    desc: 'Wheat / Barley / Sorghum (Farm)' },
  { key: 'pasture', icon: 'cattle', label: 'Pasture',
    desc: 'Cattle / Sheep / Pig / Goat / Horse' },
  { key: 'camp', icon: 'game', label: 'Camp',
    desc: 'Game / Fur / Elephant / Ivory / Camel / Exotic (worked by Camp)' },
  { key: 'grove', icon: 'wine', label: 'Grove',
    desc: 'Wine / Olive / Citrus / Honey / Lavender / Silk / Spices / Tea' },
  { key: 'nets', icon: 'fish', label: 'Nets',
    desc: 'Fish / Crab / Pearl / Dye (worked by Nets)' },
  { key: 'ore', icon: 'iron', label: 'Ore',
    desc: 'Ore (worked into iron)' },
  { key: 'precious', icon: 'gold', label: 'Precious',
    desc: 'Gem / Gold / Silver / Pearl / Jade / Ebony (in-game Precious Resources)' },
  { key: 'marble', icon: 'stone', label: 'Marble',
    desc: 'Marble (worked into stone)' },
  { key: 'horse', icon: 'horse', label: 'Horses',
    desc: 'Horse resource' },
  { key: 'ele', icon: 'elephant', label: 'Elephants',
    desc: 'Elephant resource' },
  { key: 'camel', icon: 'camel', label: 'Camels',
    desc: 'Camel resource' },
] as const;
// total best-improvement yield ON the map (Food/Iron/Stone/Wood) — same
// bar treatment, icons from the yields/ set.
const YIELD_BARS = [
  { key: 'food', icon: 'food', label: 'Food',
    desc: 'Potential Food — every tile given the best food improvement it can take (Farm, etc.), summed' },
  { key: 'iron', icon: 'iron', label: 'Iron',
    desc: 'Potential Iron — every tile given the best iron improvement it can take (Mine), summed' },
  { key: 'stone', icon: 'stone', label: 'Stone',
    desc: 'Potential Stone — every tile given the best stone improvement it can take (Quarry), summed' },
  { key: 'wood', icon: 'wood', label: 'Wood',
    desc: 'Potential Wood — every tile given the best wood improvement it can take (Lumbermill), summed' },
] as const;
// terrain / topology composition — the rest of the tournament dimensions
// the rankings page carries. Same bar treatment as resources & yields;
// glyphs are the inline SVG sprite at the top of <body> (no PNG assets).
const TERRAIN_BARS = [
  { key: 'treesTiles', icon: 'trees', label: 'Trees', pp: true,
    desc: 'Forest tiles — lumbermill sites, ranged cover, 40 wood a chop' },
  { key: 'jungleTiles', icon: 'jungle', label: 'Jungle', pp: true,
    desc: 'Jungle tiles — clearcut only (never millable), double move cost, 60 wood a chop' },
  { key: 'scrubTiles', icon: 'scrub', label: 'Scrub', pp: true,
    desc: 'Scrub tiles — 10 wood a chop, no mill' },
  { key: 'vegTiles', icon: 'veg', label: 'Vegetation', pp: true,
    desc: 'All vegetated tiles (forest + scrub + jungle)' },
  { key: 'marshTiles', icon: 'marsh', label: 'Marsh', pp: true,
    desc: 'Marsh tiles' },
  { key: 'hills', icon: 'hills', label: 'Hills', pp: true,
    desc: 'Hill tiles — mines take +60% iron here, and every one is a windmill site' },
  { key: 'watermill', icon: 'watermill', label: 'Watermill', pp: true,
    desc: 'Land tiles beside a river — watermill sites, fresh water for farms, +60% lumbermills' },
  { key: 'riverTiles', icon: 'river', label: 'River', pp: true,
    desc: 'Tiles bordering a river (a tile counts if it or a neighbour carries a river edge)' },
  { key: 'aridTiles', icon: 'sand', label: 'Arid/Sand', pp: true,
    desc: 'Arid and sand tiles — sand takes no farm, mine or flat quarry' },
  { key: 'waterTiles', icon: 'water', label: 'Water', pp: true,
    desc: 'Water tiles — land units cannot cross them' },
  { key: 'clearcutSF', icon: 'clearcut', label: 'Clearcut S+F', pp: true,
    desc: 'Clearcut scrub + forest — one-time wood from chopping every scrub (20) and forest (40) tile' },
  { key: 'clearcutWJ', icon: 'clearcut2', label: 'Clearcut S+F+J', pp: true,
    desc: 'Clearcut scrub + forest + jungle — the same total plus jungle at 60 wood per tile (identical to S+F on jungle-free maps)' },
  { key: 'rangedCover', icon: 'cover', label: 'Ranged cover', unit: 'idx',
    desc: 'INDEX, not a count: vegetation weighted by its ranged-attack penalty (scrub 25 / forest 50 / jungle 75), 0–100' },
] as const;

// ---- size-neutral comparison -----------------------------------------
// Printed numbers stay whole-map TOTALS (that is what the seeds contain),
// but bars and ranks for anything that scales with map area are computed
// PER 100 LAND TILES — otherwise the Tiny maps win every count on bulk
// alone. Percentages, distances and cut widths are already size-neutral
// and rank on their raw value.
const landBy: Record<string, number[]> = {};
for (const gn of (gensData as any).gens)
  if (gn.landTiles != null) (landBy[gn.cslug] ??= []).push(gn.landTiles);
const landMean: Record<string, number> = {};
for (const k in landBy) {
  const a = landBy[k];
  landMean[k] = a.reduce((x: number, y: number) => x + y, 0) / a.length;
}
const tileBy: Record<string, number[]> = {};
for (const gn of (gensData as any).gens)
  if (gn.tiles != null) (tileBy[gn.cslug] ??= []).push(gn.tiles);
const tileMean: Record<string, number> = {};
for (const k in tileBy) {
  const a = tileBy[k];
  tileMean[k] = a.reduce((x: number, y: number) => x + y, 0) / a.length;
}
// mean ±sd straight from the per-gen rows for the counts atlas-dist
// doesn't aggregate (playable tiles, land tiles, cap-reachable %)
const genAgg: Record<string, Record<string, { mean: number; sd: number; min: number; max: number }>> = {};
for (const gn of (gensData as any).gens) {
  for (const k of ['tiles', 'landTiles', 'reachPct'] as const) {
    if (gn[k] == null) continue;
    ((genAgg[gn.cslug] ??= {})[k] ??= { mean: 0, sd: 0, min: Infinity, max: -Infinity }) as any;
  }
}
{
  const acc: Record<string, Record<string, number[]>> = {};
  for (const gn of (gensData as any).gens)
    for (const k of ['tiles', 'landTiles', 'reachPct'] as const)
      if (gn[k] != null) ((acc[gn.cslug] ??= {})[k] ??= []).push(gn[k]);
  for (const cs in acc) for (const k in acc[cs]) {
    const a = acc[cs][k];
    const m = a.reduce((x, y) => x + y, 0) / a.length;
    const v = a.reduce((x, y) => x + (y - m) ** 2, 0) / a.length;
    genAgg[cs][k] = { mean: m, sd: Math.sqrt(v),
      min: Math.min(...a), max: Math.max(...a) };
  }
}
// dims that scale with map area → compared per 100 land tiles
const DENSITY_KEYS = new Set<string>([
  ...RES_BARS.map((b: any) => b.key), ...YIELD_BARS.map((b: any) => b.key),
  'watermill', 'clearcutWJ', 'clearcutSF', 'hills',
  'treesTiles', 'scrubTiles', 'jungleTiles', 'vegTiles', 'marshTiles',
  'aridTiles', 'waterTiles', 'riverTiles',
  'expansion', 'sites',
]);
// bars and ranks compare WHOLE-MAP TOTALS — the number actually printed
// on the card. Density (per 100 land tiles) is carried in the tooltip as
// the size-neutral cross-check, not as the ranking basis.
const cmpVal = (c: any, k: string) => c.dist?.[k]?.mean ?? null;
const dens = (c: any, k: string) => {
  if (!DENSITY_KEYS.has(k)) return null;
  const m = c.dist?.[k]?.mean;
  const L = landMean[c.slug];
  return m != null && L ? (m / L) * 100 : null;
};
const fmtD = (v: number) =>
  v >= 100 ? String(Math.round(v)) : v >= 10 ? v.toFixed(1) : v.toFixed(2);

// pool min/max of each resource's per-config mean → normalisation range,
// so every bar reads "lots vs little of this RELATIVE to the other maps".
const resRange: Record<string, { lo: number; hi: number }> = {};
for (const b of [...RES_BARS, ...YIELD_BARS, ...TERRAIN_BARS]) {
  const ms = pool.map((c: any) => cmpVal(c, b.key))
    .filter((v: any) => v != null);
  resRange[b.key] = { lo: ms.length ? Math.min(...ms) : 0,
    hi: ms.length ? Math.max(...ms) : 0 };
}
// per-config bar: fill + red→amber→green from this config's POSITION in
// the pool, not its raw magnitude. Magnitude scaling collapses whenever
// one map is an outlier — on choke the 11 tightest maps all landed within
// 11px of each other because two Tiny deserts stretched the scale — and it
// let a bar disagree with the #n badge sitting next to it. Exact values
// stay in the number above the bar and in the tooltip.
const barOf = (c: any, key: string) => {
  const d = c.dist?.[key];
  const none = !d || (d.max ?? 0) <= 0;   // map never has this at all
  const r = rk(c, key), n = rankN(key);
  const tt = (!r || n < 2) ? 0.5 : (n - r) / (n - 1);
  return { d, none, t: tt,
    w: none ? 100 : Math.round(8 + tt * 92),
    col: none ? '#23262c' : `hsl(${Math.round(tt * 125)},58%,42%)` };
};
// every pool map is mirrored, so a whole-map count splits exactly in
// half between the two players — spell that out rather than making the
// reader divide.
const half = (v: number) => {
  const h = v / 2;
  return h >= 10 ? h.toFixed(0) : h.toFixed(1).replace(/\.0$/, '');
};
const barTip = (b: any, d: any, c?: any, perPlayer = false) => {
  const u = (b as any).unit === '%' ? '%' : '';
  const what = (b as any).unit === '%' ? 'of all tiles'
    : (b as any).unit === 'idx' ? '(index, 0–100)' : 'per map';
  return (!d || (d.max ?? 0) <= 0)
    ? `${b.label} — ${b.desc}\nNone on this map.`
    : `${b.label} — ${b.desc}\navg ${d.mean}${u} ${what} (±${d.sd}${u} sd, `
      + `range ${d.min}${u}–${d.max}${u}). Bar = relative to other maps.`
      + (perPlayer ? `\n≈ ${half(d.mean)} per player — the map is mirrored, `
          + `so each side holds half (range ${half(d.min)}–${half(d.max)}).` : '')
      + (c ? rankTip(c, b.key) : '');
};

// Wall cost and Mid-land choke read the other way round: a LOW number is
// the remarkable one (sealable / pinched). Rank them fewest-first and
// flip their bar so the green end means "tight" on both.
const INVERT = new Set<string>(['wall', 'choke']);

// ---- rank badges ------------------------------------------------------
// The rankings page's actual payload is POSITION, not value. Every bar
// and pill carries "#n" = this config's rank in the 18-map pool, sorted
// high→low on the size-neutral basis above.
const rankOf: Record<string, Record<string, number>> = {};
const RANK_KEYS = [...RES_BARS, ...YIELD_BARS, ...TERRAIN_BARS]
  .map((b: any) => b.key)
  .concat(['sites', 'land', 'slLand', 'expansion', 'wall', 'choke',
           'crow', 'scout', 'slSea', 'slHatti',
           'tiles', 'landTiles', 'walkable', 'reachPct', 'tribes', 'res']);
for (const k of RANK_KEYS) {
  const rows = pool
    .map((c: any) => ({ slug: c.slug, v: cmpVal(c, k) }))
    .filter((r: any) => r.v != null)
    .sort((a: any, b: any) => INVERT.has(k)
      ? (a.v as number) - (b.v as number)
      : (b.v as number) - (a.v as number));
  rankOf[k] = {};
  rows.forEach((r: any, i: number) => { rankOf[k][r.slug] = i + 1; });
}
const rankN = (k: string) => Object.keys(rankOf[k] || {}).length;
const rk = (c: any, k: string) => rankOf[k]?.[c.slug];
const rankTip = (c: any, k: string) => {
  const r = rk(c, k);
  if (!r) return '';
  const d = dens(c, k);
  return `\nRank ${r} of ${rankN(k)} in the pool by map total `
    + `(${INVERT.has(k) ? 'fewest first — a low number is the tight end' : 'highest first'}).`
    + (d != null ? ` Size-neutral cross-check: ≈ ${fmtD(d)} per 100 land tiles.` : '');
};

// ---- hero-pill relative bars -----------------------------------------
// Same green→red language as the resource bars, applied to the headline
// stats so each pill also shows where this script sits vs the pool.
const PILL_KEYS = ['sites', 'land', 'slLand', 'expansion',
  'wall', 'choke'] as const;
const pillRange: Record<string, { lo: number; hi: number }> = {};
for (const k of PILL_KEYS) {
  const ms = pool.map((c: any) => cmpVal(c, k))
    .filter((v: any) => v != null);
  pillRange[k] = { lo: ms.length ? Math.min(...ms) : 0,
    hi: ms.length ? Math.max(...ms) : 0 };
}
// the six headline pills, data-driven so wall/choke ride the same layout
// ---- facts strip -------------------------------------------------------
// The remaining /gen stats that have no bar: the rest of the capital
// distance block and the map-shape counts. Text-only so they read as
// reference, not as another thing to compare.
const one = (c: any, k: string) => c.dist?.[k];
// a % metric's spread is in percentage points, so the unit rides the sd
// too — "99% ±2.9%", not "99% ±2.9". Word units (" turns") stay on the
// value alone, where repeating them would just be noise.
const sdU = (unit: string) => (unit === '%' ? '%' : '');
// Facts carry the same furniture as the pills and bars: value, spread,
// pool rank, and a link into the matching rankings list. Anything already
// shown as a pill (land path, land move-cost) or a terrain bar (river,
// ocean) is deliberately absent — this strip is only what has no bar.
const fact = (c: any, k: string, lab: string, unit: string, tip: string) => {
  const d = one(c, k);
  if (!d) return { lab, v: '—', sd: null, rank: null, key: k, tip };
  return { lab, key: k, v: `${d.mean}${unit}`, sd: `${d.sd}${sdU(unit)}`,
    rank: rk(c, k),
    tip: `${tip}\navg ${d.mean}${unit} ±${d.sd}${sdU(unit)} sd · median ${d.med}${unit} · range ${d.min}${unit}–${d.max}${unit}`
      + rankTip(c, k) };
};
const factRows = (c: any) => {
  const dist = [
    { lab: 'Land-connected', key: null, v: c.connPct >= 100 ? 'always' : `${c.connPct}%`,
      sd: null, rank: null,
      tip: `Capitals share a land route. Seeds with no connected pair are dropped from the pool — ${c.dropPct}% of attempts here.` },
    fact(c, 'crow', 'Crow', '', 'Straight-line capital→capital distance, ignoring terrain.'),
    fact(c, 'scout', 'Scout', ' turns', 'Turns for a scout to cross between capitals.'),
    fact(c, 'slSea', 'Move-cost water', '', 'Terrain-weighted move cost capital→capital by water.'),
    fact(c, 'slHatti', 'Move-cost Hatti-land', '', 'Move cost capital→capital by land under Hatti terrain rules.'),
  ];
  const map = [
    fact(c, 'tiles', 'Playable tiles', '', 'In-bounds tiles per map.'),
    fact(c, 'landTiles', 'Land tiles', '', 'Non-water tiles per map.'),
    fact(c, 'walkable', 'Walkable', '', 'Land minus mountains, volcanoes and lakes — where units can actually go.'),
    fact(c, 'reachPct', 'Cap-reachable', '%',
      `Share of land walkable from the capital. SPLIT (under 85%) on ${c.splitPct}% of seeds.`),
    fact(c, 'tribes', 'Tribal sites', '', 'Tribal settlements per map.'),
    fact(c, 'res', 'Resources', '', 'Total resource tiles per map.'),
  ];
  return [{ lab: 'Capital distance', items: dist },
          { lab: 'Map shape', items: map }];
};

// Six pills on a 3x2 grid. Row-major order is chosen so each COLUMN is a
// themed pair: room to grow | how far apart | how sealable.
const PILL_DEFS = [
  { key: 'sites', label: 'City sites', grp: 'Room', pp: true,
    tip: 'City sites on the map. More vs fewer, relative to the other maps.' },
  { key: 'land', label: 'Land hex distance', grp: 'Distance',
    tip: 'Capital→capital distance along land. Longer vs shorter, relative to the other maps.' },
  { key: 'wall', label: 'Wall cost', grp: 'Topology',
    tip: 'Hexes needed to seal EVERY land route between the two full-split empires (min-cut; sites are uncuttable). Low = sealable, high = open field — ranked and coloured fewest-first, so a full green bar means the most sealable map in the pool. Land only; water is not counted.' },
  { key: 'expansion', label: 'Expansion space', grp: 'Room', pp: true,
    tip: 'Urbanizable tiles — Lush/Temperate/Arid that are Flat or Hill (can host a city/urban; excludes sand, marsh, tundra, jungle, water, mountain). More = roomier, less = cramped.' },
  { key: 'slLand', label: 'Land hex cost', grp: 'Distance',
    tip: 'Capital→capital move-cost along land (terrain-weighted). Higher vs lower, relative to the other maps.' },
  { key: 'choke', label: 'Mid-land choke', grp: 'Topology',
    tip: 'Land width at the capital-equidistant midline — the fair-contest line. Low = the middle pinches, high = broad meeting ground — ranked and coloured narrowest-first. Not the same question as Wall cost.' },
] as const;

const barStyle = (c: any, key: string) => {
  const b = barOf(c, key);
  return `width:${b.w}%;background:${b.col}`;
};
