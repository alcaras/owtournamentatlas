      overflow:auto; }
    .pop__l a { font-size:0.66rem; color:var(--text-soft);
      text-decoration:none; background:#16181d;
      border:1px solid var(--border-strong); border-radius:4px;
      padding:0.1rem 0.35rem; white-space:nowrap; }
    .pop__l a:hover { color:var(--gold); border-color:var(--gold); }
    .pop__l i { font-style:normal; color:var(--text-dim);
      font-family:var(--font-mono); font-size:0.6rem; }
    .chart__cap { font-size:0.66rem; color:var(--text-faint);
      line-height:1.45; margin-top:0.45rem; font-family:var(--font-ui); }

    /* ---- per-config unit dot-histograms ---- */
    .cfgdist { display:grid; grid-template-columns:1fr 1fr; gap:1.2rem;
      margin-top:0.7rem; }
    @media (max-width:680px){ .cfgdist{ grid-template-columns:1fr; } }
    .cd__t { font-size:0.6rem; letter-spacing:0.12em;
      text-transform:uppercase; color:var(--text-dim);
      margin-bottom:0.35rem; display:flex; gap:0.5rem; align-items:baseline; }
    .cd__t span { text-transform:none; letter-spacing:0;
      font-family:var(--font-ui); color:var(--text-faint);
      font-size:0.62rem; }
    .cd__cols { display:flex; align-items:flex-end; gap:3px; min-height:24px; }
    .cd__col { flex:1 1 0; min-width:0; display:flex;
      flex-direction:column; align-items:center; }
    .cd__stack { display:flex; flex-direction:column-reverse;
      gap:2px; width:100%; align-items:center; }
    .dot { width:11px; height:11px; border-radius:2px; display:block;
      background:var(--zb); border:1px solid var(--zc); }
    .dot:hover { outline:1px solid var(--gold); outline-offset:1px;
      filter:brightness(1.3); }
    .cd__x { font-size:0.52rem; font-family:var(--font-mono);
      color:var(--text-dim); margin-top:3px; white-space:nowrap; }
  </style>

  <script is:inline>
    /* copy-name / copy-link buttons */
    (function(){
      function copyText(t){
        if(navigator.clipboard && navigator.clipboard.writeText)
          return navigator.clipboard.writeText(t);
        var ta=document.createElement('textarea');
        ta.value=t; ta.style.position='fixed'; ta.style.opacity='0';
        document.body.appendChild(ta); ta.select();
        try{ document.execCommand('copy'); }catch(e){}
        document.body.removeChild(ta);
        return Promise.resolve();
      }
      function flash(b){
        b.classList.add('ok'); clearTimeout(b._t);
        b._t=setTimeout(function(){ b.classList.remove('ok'); },1200);
      }
      document.querySelectorAll('.cfg__copy').forEach(function(b){
        b.addEventListener('click',function(e){
          e.preventDefault();
          copyText(b.getAttribute('data-copy')||'').then(function(){ flash(b); });
        });
      });
      document.querySelectorAll('.cfg__link').forEach(function(b){
        b.addEventListener('click',function(e){
          e.preventDefault();
          var a=b.getAttribute('data-anchor')||'';
          var url=location.origin+location.pathname+'#'+a;
          copyText(url).then(function(){
            flash(b);
            if(history.replaceState) history.replaceState(null,'','#'+a);
          });
        });
      });
    })();
    /* in-page hash navigation (gallery imgs carry width/height now, so
       native fragment scrolling lands on cold loads — no load-time
       re-scroll needed; it could yank the viewport from a user who had
       already scrolled away on a slow connection). */
    (function(){
      window.addEventListener('hashchange',function(){
        if(!location.hash) return;
        var el=document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if(el) el.scrollIntoView({block:'start'});
      });
    })();
    (function(){
      var links=[].slice.call(document.querySelectorAll('.snav__l'));
      var secs=links.map(function(l){
        return document.getElementById(l.getAttribute('data-anchor')); });
      function spy(){
        var best=0, bt=-1e9;
        secs.forEach(function(s,i){
          if(!s) return;
          var t=s.getBoundingClientRect().top-110;
          if(t<=0 && t>bt){ bt=t; best=i; }
        });
        links.forEach(function(l,i){ l.classList.toggle('on', i===best); });
      }
      window.addEventListener('scroll',function(){
        window.requestAnimationFrame(spy); },{passive:true});
      spy();
    })();
    (function(){
      var btn=document.getElementById('randPick');
      var hint=document.getElementById('randHint');
      if(!btn) return;
      var cfgs=[].slice.call(document.querySelectorAll('.cfg'));
      btn.addEventListener('click',function(){
        if(!cfgs.length) return;
        var el=cfgs[Math.floor(Math.random()*cfgs.length)];
        var nm=el.querySelector('.cfg__name');
        if(hint&&nm) hint.textContent='→ '+nm.textContent;
        if(el.id) history.replaceState(null,'','#'+el.id);
        el.scrollIntoView({behavior:'smooth',block:'start'});
        cfgs.forEach(function(c){ c.classList.remove('flash'); });
        void el.offsetWidth;            // restart the flash animation
        el.classList.add('flash');
      });
    })();
  </script>
</Base>
